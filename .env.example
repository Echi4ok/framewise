# Docker local model. The first launch downloads the model into a Docker volume.
MODEL_BASE_URL=http://model:11434/v1
MODEL_NAME=qwen3-vl:8b-instruct
LOCAL_MODEL_NAME=qwen3-vl:8b-instruct
MODEL_API_KEY=local
MODEL_RESPONSE_FORMAT=json_schema
MODEL_TIMEOUT_SECONDS=300
MANUAL_IMPORT_TIMEOUT_SECONDS=60
IMAGE_URL_TIMEOUT_SECONDS=20
BODY_READ_TIMEOUT_SECONDS=15
MAX_CONCURRENT_IMPORTS=2
MAX_MODEL_REQUESTS=4
IMAGE_WORKERS=2
STORE_CLEANUP_INTERVAL_SECONDS=30

# MODEL_TIMEOUT_SECONDS is the whole operation budget, including queue and repair.
# nginx waits 360s; increase its proxy_read_timeout if the model budget is raised.
# Local model-init verifies the recorded manifest for 4b-instruct or 8b-instruct.

# For another OpenAI-compatible service, set its URL, model and private key.
# Set MODEL_RESPONSE_FORMAT=json_object if the provider does not support JSON Schema.
# Server-side validation runs for both modes.
